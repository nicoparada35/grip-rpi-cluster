# =============================================================================
# GRIP Basketball — Raspberry Pi 4B (4GB RAM / 32GB microSD) Cluster Config
# Copy to /opt/grip/config/cluster.env on each Raspberry Pi (done automatically
# by scripts/02-install-code.sh)
# =============================================================================

# --- Node Identity (Set per Raspberry Pi) ---
# Allowed values: edge | app | db | all-in-one | kiosk
GRIP_NODE_ROLE=edge
GRIP_NODE_HOSTNAME=grip-edge

# --- Network Topology (mDNS .local or Static LAN IPs) ---
# By default, Avahi mDNS resolves grip-edge.local, grip-app.local, grip-db.local
# automatically on any local router/switch (even when repositioned to a new court).
# You can also set static IPs here if preferred (e.g., 192.168.1.101).
GRIP_EDGE_HOST=grip-edge.local
GRIP_APP_HOST=grip-app.local
GRIP_DB_HOST=grip-db.local

# Public/LAN URL used in confirmation links and Kiosk display
GRIP_FRONTEND_URL=http://grip.local
GRIP_WEB_PORT=80
GRIP_BACKEND_PORT=8080
GRIP_LIVESYNC_PORT=5500
GRIP_DB_PORT=5432
GRIP_MAILPIT_SMTP_PORT=1025
GRIP_MAILPIT_UI_PORT=8025

# --- PostgreSQL 16 Database Credentials (RPi #3: grip-db) ---
GRIP_DB_NAME=gripdb
GRIP_DB_USER=grip
GRIP_DB_PASSWORD=GripRpiCluster2026!

# --- Spring Boot Backend & JWT Security (RPi #2: grip-app) ---
SPRING_PROFILES_ACTIVE=rpi
GRIP_JWT_SECRET=GRIP_RPI4_CLUSTER_LOCAL_SECRET_KEY_2026_64_BYTES_MINIMUM_SECURITY
GRIP_JWT_EXPIRATION_MS=2592000000
GRIP_ADMIN_EMAIL=admin@gripbasketball.com
GRIP_ADMIN_PASSWORD=GripAdmin2026!
GRIP_AUTO_VERIFY_LOCAL=true
GRIP_SMTP_HOST=grip-mailpit
GRIP_SMTP_PORT=1025

# --- Continuous Deployment (CD) Settings ---
# URL of this deployment repository
GRIP_CLUSTER_REPO_URL=https://github.com/nicoparada35/grip-rpi-cluster.git
GRIP_CLUSTER_BRANCH=main

# URL & Branch of the web application submodule
GRIP_WEB_SUBMODULE_PATH=submodules/grip-basketball-fullstack
GRIP_WEB_REPO_URL=https://github.com/Victor151203/grip-basketball-fullstack.git
GRIP_WEB_BRANCH=dev

# If true, CD automatically pulls the latest commit on GRIP_WEB_BRANCH of the
# web submodule even if the parent repo submodule pointer hasn't been bumped yet.
GRIP_CD_TRACK_SUBMODULE_LATEST=true

# Webhook secret for instant push deployments (port 9000)
GRIP_WEBHOOK_PORT=9000
GRIP_WEBHOOK_SECRET=GripWebhookSecret2026!

# --- Backup Retention (32GB microSD Protection) ---
GRIP_BACKUP_RETENTION_DAYS=14
