[Unit]
Description=GRIP Basketball Node Startup Service (Role-Based Docker Stack)
After=network-online.target docker.service avahi-daemon.service
Wants=network-online.target docker.service avahi-daemon.service

[Service]
Type=oneshot
RemainAfterExit=yes
EnvironmentFile=-/opt/grip/config/cluster.env
WorkingDirectory=/opt/grip/repo
ExecStart=/usr/bin/env bash /opt/grip/repo/scripts/grip-boot-guard.sh --start
TimeoutStartSec=900
Restart=on-failure
RestartSec=15

[Install]
WantedBy=multi-user.target
